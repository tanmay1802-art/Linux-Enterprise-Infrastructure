[DEFAULT]
bantime = 10m
findtime = 5m
maxretry = 4
backend = auto
banaction = firewallcmd-ipset


[sshd]
enabled = true
port = ssh
logpath = /var/log/secure
maxretry = 4

[dovecot]
enabled = true
port = pop3,pop3s,imap,imaps,submission,465,587,993
logpath = /var/log/maillog
maxretry = 4

[recidive]
enabled = true
logpath = /var/log/fail2ban.log
banaction = firewallcmd-ipset
bantime = 1d
findtime = 1d
maxretry = 3
